# Copy to .env (never commit .env). All keys stay on the server (PLAN §10.7).
GEMINI_API_KEY=
GROQ_API_KEY=
# GEMINI_DECIDE_MODEL=gemini-3.1-flash-lite
# GEMINI_GENERATE_MODEL=gemini-3.5-flash
# GEMINI_API_KEY_2=   (optional second free key: its own quota, tried after key 1)
# GEMMA_MODEL=gemma-4-26b-a4b-it
# GROQ_MODEL=openai/gpt-oss-120b
# GROQ_GEN_LANGS=en,hi   (Groq models misuse Odia textbook terms; see spikes/RESULTS.md)
# Languages that get live generated explanations (P0 a decides Odia): en,hi,or
SETU_LIVE_GEN=en
# 1 = treat draft (unreviewed) content as trusted, development only
SETU_TRUST_DRAFT=1
PORT=8787
# Firebase Authentication server-side token verification
FIREBASE_PROJECT_ID=agentic-ai-5698c
# For local development, set GOOGLE_APPLICATION_CREDENTIALS to your service-account JSON path.
# Alternatively, set FIREBASE_SERVICE_ACCOUNT_JSON in a secret manager. Never commit credentials.
# Enables POST /admin/tick (header x-admin-key) to run the schedule tick on demand (demo)
# SETU_ADMIN_KEY=
# SETU_TICK_MIN=10
